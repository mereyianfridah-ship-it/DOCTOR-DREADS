NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# REQUIRED: PostgreSQL connection string (Supabase, Neon, Render Postgres, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drdread"
# REQUIRED in production: 32+ random chars (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Optional: create an admin automatically on first start (password 10+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Minutes an unpaid order/booking holds stock or a slot (agreed: 10)
HOLD_MINUTES=10

# --- Payments ---
# mock   = payments succeed instantly, NO money moves (dev/demo only)
# daraja = real M-Pesa STK push (fill in the values below)
# disabled = no payment processing allowed (production default)
PAYMENTS_MODE=disabled
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS base URL Safaricom can reach (use a tunnel such as ngrok locally)
MPESA_CALLBACK_BASE_URL=
# Long random string; becomes part of the callback URL so only Safaricom's call is accepted
MPESA_CALLBACK_SECRET=

# Session cookie SameSite policy.
#   none = works with Vercel -> Render on different sites, but Safari/Firefox strict modes BLOCK it.
#   lax  = recommended; requires the API to be same-site as the frontend (custom domain pair such as
#          www.example.co.ke + api.example.co.ke, or a Vercel rewrite of /api/* to the backend).
COOKIE_SAMESITE=none

# Cloudinary (REQUIRED in production for image uploads): cloudinary://api_key:api_secret@cloud_name
# Obtain from your Cloudinary console dashboard.
CLOUDINARY_URL=

