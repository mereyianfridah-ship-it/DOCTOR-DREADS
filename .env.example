# Base URL of the Dr Dread API, e.g. https://api.your-domain.example (no trailing slash).
# Leave empty during development: Vite proxies /api to http://localhost:4000.
VITE_API_URL=

# Developer preview: replace bundled placeholder SVGs with real stock photos matching each slot.
# Defaults to on. Set to "false" once the client has supplied real photography.
VITE_PREVIEW_IMAGES=true

# Photos are served from public/images/photos/. Download them once with:
#   PEXELS_API_KEY=your_free_key npm run photos      (key: https://www.pexels.com/api/)
